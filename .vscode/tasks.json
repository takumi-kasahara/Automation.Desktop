{
  "version": "2.0.0",
  "options": {},
  "presentation": {
    "reveal": "silent",
    "revealProblems": "onProblem"
  },
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "pwsh.exe",
      "args": ["-NoLogo", "-NoProfile", "-File", "Build.ps1"],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "pester",
      "type": "shell",
      "command": "cmd.exe",
      "args": [
        "/c",
        ".agents\\skills\\powershell-7\\scripts\\Pester.bat",
        "-Path",
        "${file}"
      ],
      "problemMatcher": ["$pester"],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "cscript",
      "type": "shell",
      "command": "cscript.exe",
      "args": ["//NoLogo", "//X", "${file}"],
      "problemMatcher": []
    }
  ]
}
