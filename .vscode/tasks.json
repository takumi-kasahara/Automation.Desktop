{
  "version": "2.0.0",
  "options": {},
  "presentation": {
    "reveal": "silent",
    "revealProblems": "onProblem"
  },
  "tasks": [
    {
      "label": "build",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "dependsOn": ["build: docs", "build: runner"]
    },
    {
      "label": "build: docs",
      "type": "shell",
      "command": "pwsh.exe",
      "args": ["-NoLogo", "-NoProfile", "-File", "Docs.ps1"],
      "problemMatcher": [],
      "hide": true
    },
    {
      "label": "build: runner",
      "type": "shell",
      "command": "pwsh.exe",
      "args": ["-NoLogo", "-NoProfile", "-File", "Build.ps1"],
      "problemMatcher": [],
      "hide": true
    },
    {
      "label": "cscript",
      "type": "shell",
      "command": "cscript.exe",
      "args": ["//NoLogo", "//X", "${file}"],
      "problemMatcher": []
    },
    {
      "label": "pester",
      "type": "shell",
      "command": "cmd.exe",
      "args": [
        "/c",
        ".agents\\skills\\powershell-7\\scripts\\pester.cmd",
        "-Path",
        "${file}"
      ],
      "problemMatcher": ["$pester"],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "psscriptanalyzer",
      "type": "shell",
      "command": "cmd.exe",
      "args": [
        "/c",
        ".agents\\skills\\powershell-7\\scripts\\analyze.cmd",
        "-Path",
        "${file}"
      ],
      "problemMatcher": [],
      "group": {
        "kind": "test"
      }
    }
  ]
}
